{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
    },
    "generate": {
      "dependsOn": ["^generate"],
    },
    "lint": {
      "outputs": [".cache/.eslintcache"],
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
    },
  },
}
