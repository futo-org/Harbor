# Metro dev server for the web app, used by the k3d stack (deploy/local) in
# --build mode. Build context is the repo root.
#
# Self-contained like services/verifier-bot/Dockerfile.dev: compiles rs-core
# to wasm and builds the JS SDKs from source, so no host prebuild is needed.
# Tilt syncs apps/harbor and the SDK sources into the running container and
# Metro reloads them; a Rust change rebuilds the image.
FROM rust:1.99-slim-bookworm@sha256:24707e70a4f1e23d9a7b25202ec43126d28a52294b96aad5c670df1fd1f1d400
WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="/pnpm:$PATH"
# No git in the build context; make husky's root `prepare` script a no-op.
ENV HUSKY=0
# Non-interactive `expo start`.
ENV CI=1
ENV EXPO_NO_TELEMETRY=1
ENV APP_VARIANT=dev

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
     curl ca-certificates git pkg-config libssl-dev cmake g++ make python3 \
     protobuf-compiler \
  && curl -fsSL https://deb.nodesource.com/setup_26.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown
# wasm-bindgen-cli must match the `wasm-bindgen` pin in packages/rs-core/Cargo.toml.
RUN cargo install wasm-bindgen-cli@0.2.125

# Cargo workspace: every member must be present for the workspace to resolve,
# even though only rs-core (+ rs-common) is compiled to wasm here.
COPY Cargo.toml Cargo.lock ./
COPY protos protos
COPY packages/rs-common packages/rs-common
COPY packages/rs-core packages/rs-core
COPY services services
COPY tools tools

COPY turbo.jsonc pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN npm install -g "$(node -p "require('./package.json').packageManager")"
COPY patches patches
COPY apps/harbor apps/harbor
COPY packages/rs-core-wasm packages/rs-core-wasm
COPY packages/js-core packages/js-core
COPY packages/js-browser packages/js-browser
COPY packages/js-storage-sqlite packages/js-storage-sqlite
COPY packages/react-native packages/react-native

# --ignore-scripts as in the production Dockerfile; allowUnusedPatches because
# the workspace members left out of this image may be patch targets.
RUN pnpm install --frozen-lockfile --ignore-scripts --config.allowUnusedPatches=true

# The app's dependencies (wasm core, SDKs) in turbo's order. Filtered because
# `services` is here for the Cargo workspace, and its JS members are not wanted.
RUN pnpm turbo run build --filter=polycentric-app...

EXPOSE 8081
CMD ["pnpm", "--filter", "polycentric-app", "web", "--port", "8081"]
