// Applied to every target of Release simulator builds through XCODE_XCCONFIG_FILE
// (see the ios:release script in package.json).
//
// Release builds default to ONLY_ACTIVE_ARCH = NO and would also build x86_64
// for the simulator, but the Rust core xcframework ships only arm64 slices and
// iOS 26+ simulators have no x86_64 runtime anyway. Building only the active
// arch keeps Release simulator builds linking with vanilla Pods.
ONLY_ACTIVE_ARCH = YES
