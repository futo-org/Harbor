{
  "name": "polycentric-app",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "APP_VARIANT=dev expo start",
    "android": "APP_VARIANT=dev expo run:android",
    "ios": "APP_VARIANT=dev expo run:ios --device",
    "ios:e2e": "npx eas-cli env:exec staging 'APP_VARIANT=dev expo run:ios --configuration Release --device'",
    "ios:simulator": "APP_VARIANT=dev expo run:ios",
    "ios:release": "XCODE_XCCONFIG_FILE=$PWD/ios-simulator.xcconfig APP_VARIANT=dev expo run:ios --configuration Release --no-bundler",
    "android:release": "APP_VARIANT=dev expo run:android --variant release --no-bundler",
    "android:prod": "expo run:android",
    "ios:prod": "expo run:ios",
    "web": "APP_VARIANT=dev expo start --web",
    "build:web": "APP_VARIANT=dev expo export --platform web",
    "serve:web": "PORT=8081 node server.js",
    "test": "jest",
    "test:ci": "jest --reporters=default --reporters=jest-junit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:cycles": "biome lint --only=suspicious/noImportCycles --error-on-warnings .",
    "prebuild": "APP_VARIANT=dev expo prebuild --clean",
    "typecheck": "tsc && tsc -p tsconfig.test.json",
    "generate:emoji-tags": "node scripts/generate-emoji-tags.mts && biome format --write src/features/reaction/emojiTags.json",
    "generate:twemoji-font": "uv run scripts/generate-twemoji-font.py"
  },
  "dependencies": {
    "@bsky.app/react-native-uitextview": "^2.7.1",
    "@codeherence/react-native-header": "^1.0.1",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ui": "~58.0.25",
    "@expo/vector-icons": "^15.1.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@lodev09/react-native-true-sheet": "^3.10.1",
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@polycentric/react-native": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-documents/picker": "^12.0.2",
    "@rn-primitives/dropdown-menu": "^1.4.0",
    "@rn-primitives/hover-card": "^1.4.0",
    "@rn-primitives/popover": "^1.4.0",
    "@rn-primitives/portal": "^1.4.0",
    "@rn-primitives/radio-group": "^1.4.0",
    "@rn-primitives/toast": "^1.4.0",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/react-native-web": "^0.19.2",
    "expo": "^58.0.21",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-screen-orientation": "~58.0.3",
    "expo-server": "~58.0.6",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.6",
    "fuzzysort": "^4.0.2",
    "js-base64": "^3.7.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-barcode-scanner": "^5.2.3",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-remove-scroll": "^2.7.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/metro-config": "0.88.1",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "emojibase-data": "^18.0.0",
    "jest": "catalog:",
    "jest-expo": "~58.0.13",
    "jest-junit": "catalog:",
    "only-allow": "^1.2.2",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": ["@shopify/flash-list"]
    },
    "autolinking": {
      "ios": {
        "exclude": ["react-native-vision-camera-barcode-scanner"]
      }
    }
  },
  "jest-junit": {
    "suiteNameTemplate": "{filepath}",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  }
}
