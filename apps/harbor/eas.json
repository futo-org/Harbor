{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "e2e": {
      "extends": "development",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true,
        "image": "latest"
      }
    },
    "staging": {
      "autoIncrement": true,
      "environment": "staging",
      "env": {
        "APP_VARIANT": "staging",
        "APP_DISTRIBUTION": "store"
      }
    },
    "staging-apk": {
      "extends": "staging",
      "distribution": "internal",
      "environment": "staging",
      "env": {
        "APP_VARIANT": "staging",
        "APP_DISTRIBUTION": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_DISTRIBUTION": "store"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "environment": "production",
      "env": {
        "APP_DISTRIBUTION": "apk"
      }
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "ascAppId": "6800794994"
      },
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6504881935"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
