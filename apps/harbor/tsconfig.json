{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // RN 0.87+ strict types clash with @types/react-native-web; legacy types
    // until we migrate
    "customConditions": ["react-native-legacy-deep-imports"],
    "jsx": "react-jsx",
    "types": ["node", "react-native-web"],
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "**/*.ts",
    "**/*.mts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Overriding `exclude` drops the base config's list, so restate it.
  "exclude": ["node_modules", "android", "ios", "**/*.test.ts", "**/*.test.tsx"]
}
