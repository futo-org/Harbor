# Copy to `.env` and edit for local dev. Variables are read in
# services/grayjay-migrator/src/config.rs. Commented out variables are optional.

#
## Both binaries
#

# The migrator's own Postgres.
#DATABASE_URL=postgres://postgres:testing@localhost:5432
#POLYCENTRIC_GRAYJAY_MIGRATOR_DATABASE_SCHEMA=grayjay_migrator

#
## grayjay-migrate (the tool)
#

# Read-only Postgres of the legacy (v1) server. `sync-legacy` only.
POLYCENTRIC_GRAYJAY_MIGRATOR_LEGACY_DATABASE_URL=

# Hex 32-byte ed25519 seed that signs every migrated identity. `re-sign` only.
POLYCENTRIC_GRAYJAY_MIGRATOR_SIGNING_KEY=

# Comma-separated Harbor gRPC URLs to push to. `push` only.
POLYCENTRIC_GRAYJAY_MIGRATOR_SERVERS=http://localhost:3000

# Comma-separated server URLs written into each identity document. Part of the
# identity hash, so set it before the first `re-sign`.
POLYCENTRIC_GRAYJAY_MIGRATOR_IDENTITY_SERVERS=http://localhost:3000

# YouTube Data API v3 key for `enrich-youtube`.
#POLYCENTRIC_GRAYJAY_MIGRATOR_YOUTUBE_API_KEY=

# Systems processed in parallel by `re-sign` and `push`.
#POLYCENTRIC_GRAYJAY_MIGRATOR_CONCURRENCY=32

# Moderation service Postgres for `seed-moderation`.
#POLYCENTRIC_GRAYJAY_MIGRATOR_MODERATION_DATABASE_URL=
#POLYCENTRIC_GRAYJAY_MIGRATOR_MODERATION_DATABASE_SCHEMA=moderation

#
## grayjay-migrator (the lookup service)
#

#POLYCENTRIC_GRAYJAY_MIGRATOR_HTTP_ADDR=0.0.0.0:3003

# Either "json" or "text". Defaults to text if stdout is a terminal.
#LOG_FORMAT=
#RUST_LOG=info
#METRICS_PORT=9464
