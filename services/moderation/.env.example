POLYCENTRIC_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
POLYCENTRIC_KAFKA_SASL_MECHANISM=SCRAM-SHA-256
POLYCENTRIC_KAFKA_SASL_USERNAME=
POLYCENTRIC_KAFKA_SASL_PASSWORD=

# Identity this service signs and publishes labels under.
# Hex-encoded 32-byte ed25519 seed (private key).
POLYCENTRIC_MODERATION_SIGNING_KEY=
# Hex identity string (sha256 of the genesis Identity content).
POLYCENTRIC_MODERATION_IDENTITY=
# Comma-separated gRPC server URLs to bootstrap from and publish to.
POLYCENTRIC_MODERATION_SERVERS=http://localhost:3000

# PhotoDNA CSAM matching. If POLYCENTRIC_PHOTODNA_KEY is unset, CSAM scanning is
# disabled, the service logs a startup warning, and moderates with Azure only.
POLYCENTRIC_PHOTODNA_KEY=
# Optional. Defaults to https://api.microsoftmoderator.com/photodna/v1.0 .
POLYCENTRIC_PHOTODNA_ENDPOINT=

# S3-compatible object store holding the image blobs to be moderated. Requires
# delete permissions to delete blobs on a confirmed CSAM match.
CONTENT_BLOB_OS_BUCKET=
# Defaults to us-east-1 when unset.
CONTENT_BLOB_OS_REGION=
# Optional custom endpoint (required if not using AWS S3).
CONTENT_BLOB_OS_ENDPOINT=
# Set to true for path-style addressing (RustFS and some S3-compatible stores).
CONTENT_BLOB_OS_FORCE_PATH_STYLE=
# Credentials. When unset, AWS SDK's default credential chain is used.
CONTENT_BLOB_OS_ACCESS_KEY=
CONTENT_BLOB_OS_SECRET_KEY=
