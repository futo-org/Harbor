
# Copy to `.env` and edit for local dev.
#
# Values here are the defaults env var is unset. Locations where the variables
# are used:
#  * services/moderation/src/config.rs
#  * services/common/object-store/src/lib.rs
#  * services/common/kafka/src/config.rs
#  * services/common/telemetry/src/lib.rs
#  * services/moderation/migration/src/main.rs (migrations only)
#
# All commented out variables are optional.

#
## Service env vars
#

# Comma-separated gRPC server URLs to bootstrap from and publish to.
HARBOR_MODERATION_SERVERS=http://localhost:3000

# Identity this service signs and publishes labels under.
# Hex-encoded 32-byte ed25519 seed (private key).
HARBOR_MODERATION_SIGNING_KEY=
# Hex identity string (sha256 of the genesis Identity content).
HARBOR_MODERATION_IDENTITY=

# Postgres database address to connect to.
#DATABASE_URL=postgres://postgres:testing@localhost:5432

# Database schema to use.
#HARBOR_MODERATION_DATABASE_SCHEMA=moderation

# Azure AI Content Safety resource used for automatic content review.
# NOTE: must both be set.
#HARBOR_AZURE_CONTENT_SAFETY_KEY=
#HARBOR_AZURE_CONTENT_SAFETY_ENDPOINT=

# PhotoDNA CSAM matching. If HARBOR_PHOTODNA_KEY is unset, CSAM scanning is
# disabled, the service logs a startup warning, and moderates with Azure only.
#HARBOR_PHOTODNA_KEY=
# Endpoint to use.
#HARBOR_PHOTODNA_ENDPOINT=https://api.microsoftmoderator.com/photodna/v1.0

#
## Object store client env vars
#

# S3 bucket where uploaded blob bodies are stored. Objects are keyed by
# `{digest_type}_{hex(digest_value)}`.
CONTENT_BLOB_OS_BUCKET=harbor-blobs

# Region the bucket lives in.
# CONTENT_BLOB_OS_REGION=us-east-1

# Custom endpoint URL for S3-compatible stores. Defaults to for AWS S3.
# CONTENT_BLOB_OS_ENDPOINT=http://localhost:9000

# Set to `true` for path-style addressing.
# Required by RustFS.
# CONTENT_BLOB_OS_FORCE_PATH_STYLE=false

# Static credentials for the blob store. If unset, the AWS SDK's default chain
# is used (shared config, container/EC2 metadata).
# CONTENT_BLOB_OS_ACCESS_KEY=...
# CONTENT_BLOB_OS_SECRET_KEY=...

#
## Kafka client env vars
#

# Value of bootstrap.servers.
#HARBOR_KAFKA_BROKERS=localhost:9092
# Value of security.protocol.
#HARBOR_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# SASL settings.
# sasl.mechanism
#HARBOR_KAFKA_SASL_MECHANISM=...
# sasl.username
#HARBOR_KAFKA_SASL_USERNAME=...
# sasl.password
#HARBOR_KAFKA_SASL_PASSWORD=...

# TLS client authentication settings.
# ssl.ca.pem
#HARBOR_KAFKA_SSL_CA=...
# ssl.certificate.pem
#HARBOR_KAFKA_SSL_CERTIFICATE=...
# ssl.key.pem
#HARBOR_KAFKA_SSL_KEY=...

# Value of broker.address.family.
#HARBOR_KAFKA_BROKER_ADDRESS_FAMILY = "any"

# Prefix to allow the broken to be shared. Defaults to no prefix.
#HARBOR_KAFKA_CLUSTER_ID=...

# Valud of auto.offset.reset.
#HARBOR_KAFKA_AUTO_OFFSET_RESET=latest

#
## Telemetry env vars
#

# Either "json" or "text". Defaults to text if stdout is a terminal.
#LOG_FORMAT=

# Level to use when logging.
#RUST_LOG=info

# Port to serve metrics on.
#METRICS_PORT=9464

#
## Migrations env vars
#

# Database schema to use.
# NOTE: also used by service.
#HARBOR_MODERATION_DATABASE_SCHEMA=moderation

