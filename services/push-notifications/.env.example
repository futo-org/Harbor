POLYCENTRIC_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
POLYCENTRIC_KAFKA_SASL_MECHANISM=SCRAM-SHA-256
POLYCENTRIC_KAFKA_SASL_USERNAME=
POLYCENTRIC_KAFKA_SASL_PASSWORD=

# Comma-separated gRPC server URLs to fetch identity/profile data from
# (used to resolve display names and authorized keys).
POLYCENTRIC_QUERY_SERVERS=http://localhost:3000

# The server to expect events from in the kafka stream
# Notifications will only be fired for events from this server to
# prevent duplicate notifications
POLYCENTRIC_MAIN_SERVER=http://localhost:3000

# Address the NotificationService gRPC server listens on (optional;
# defaults to 0.0.0.0:3001).
POLYCENTRIC_NOTIFICATIONS_GRPC_ADDR=0.0.0.0:3001

# Expo access token used to send push notifications (optional).
EXPO_ACCESS_TOKEN=
