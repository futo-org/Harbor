# verifier-bot configuration. Copy to `.env` and fill in.
# Every variable is prefixed with HARBOR_VERIFIER_BOT_.

# ── Core ───────────────────────────────────────────────────────────────────
# Polycentric server(s) the bot syncs with. Comma-delimited for multiple.
HARBOR_VERIFIER_BOT_SERVERS=https://east.polycentric.dev
# Postgres connection string; unset uses a local sqlite file (./state).
# `?schema=<name>` keeps the bot's tables under their own schema.
# HARBOR_VERIFIER_BOT_DATABASE_URL=postgres://postgres:testing@localhost:5432/polycentric?schema=verifier_bot
# Comma-delimited list of origins allowed by CORS.
HARBOR_VERIFIER_BOT_ALLOWED_ORIGINS=http://localhost:8081,https://harbor.social
# Comma-delimited callback URL prefixes clients may have the OAuth callback
# redirect to (app deep links and web app origins).
HARBOR_VERIFIER_BOT_ALLOWED_CALLBACKS=harbor://,exp://,exps://,http://localhost:8081,https://harbor.social
# Public base domain of THIS bot, used to build OAuth callback URLs.
HARBOR_VERIFIER_BOT_OAUTH_CALLBACK_DOMAIN=https://verifier-bot.harbor.social
# Path to a Chrome/Chromium binary for the Puppeteer-based verifiers (e.g. Kick).
HARBOR_VERIFIER_BOT_PUPPETEER_EXECUTABLE_PATH=
# Profile published for the bot's identity on first run (clients show this
# name next to the bot's verifications).
HARBOR_VERIFIER_BOT_PROFILE_NAME=Verifier
HARBOR_VERIFIER_BOT_PROFILE_DESCRIPTION=Automated verifier of platform claims.

# ── OAuth credentials (only needed for the platforms you enable) ─────────────
HARBOR_VERIFIER_BOT_DISCORD_CLIENT_ID=
HARBOR_VERIFIER_BOT_DISCORD_CLIENT_SECRET=

HARBOR_VERIFIER_BOT_X_API_KEY=
HARBOR_VERIFIER_BOT_X_API_SECRET=

HARBOR_VERIFIER_BOT_SPOTIFY_CLIENT_ID=
HARBOR_VERIFIER_BOT_SPOTIFY_CLIENT_SECRET=

HARBOR_VERIFIER_BOT_INSTAGRAM_CLIENT_ID=
HARBOR_VERIFIER_BOT_INSTAGRAM_CLIENT_SECRET=

HARBOR_VERIFIER_BOT_PATREON_CLIENT_ID=
HARBOR_VERIFIER_BOT_PATREON_CLIENT_SECRET=
