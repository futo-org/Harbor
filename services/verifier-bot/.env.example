# verifier-bot configuration. Copy to `.env` and fill in.
# Every variable is prefixed with POLYCENTRIC_VERIFIER_BOT_.

# ── Core ───────────────────────────────────────────────────────────────────
# Polycentric server(s) the bot syncs with. Comma-delimited for multiple.
POLYCENTRIC_VERIFIER_BOT_SERVERS=https://east.polycentric.dev
# Comma-delimited list of origins allowed by CORS.
POLYCENTRIC_VERIFIER_BOT_ALLOWED_ORIGINS=http://localhost:3000,https://harbor.social
# Base URL the web app is served from (OAuth callbacks redirect back here).
POLYCENTRIC_VERIFIER_BOT_WEB_APP_URL=https://harbor.social
# Public base domain of THIS bot, used to build OAuth callback URLs.
POLYCENTRIC_VERIFIER_BOT_OAUTH_CALLBACK_DOMAIN=https://verifier-bot.harbor.social
# Path to a Chrome/Chromium binary for the Puppeteer-based verifiers (e.g. Kick).
POLYCENTRIC_VERIFIER_BOT_PUPPETEER_EXECUTABLE_PATH=

# ── OAuth credentials (only needed for the platforms you enable) ─────────────
POLYCENTRIC_VERIFIER_BOT_DISCORD_CLIENT_ID=
POLYCENTRIC_VERIFIER_BOT_DISCORD_CLIENT_SECRET=

POLYCENTRIC_VERIFIER_BOT_X_API_KEY=
POLYCENTRIC_VERIFIER_BOT_X_API_SECRET=

POLYCENTRIC_VERIFIER_BOT_SPOTIFY_CLIENT_ID=
POLYCENTRIC_VERIFIER_BOT_SPOTIFY_CLIENT_SECRET=

POLYCENTRIC_VERIFIER_BOT_INSTAGRAM_CLIENT_ID=
POLYCENTRIC_VERIFIER_BOT_INSTAGRAM_CLIENT_SECRET=

POLYCENTRIC_VERIFIER_BOT_PATREON_CLIENT_ID=
POLYCENTRIC_VERIFIER_BOT_PATREON_CLIENT_SECRET=
