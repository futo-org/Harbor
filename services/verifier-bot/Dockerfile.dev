# Local development image (referenced by the root compose.yml). Build context
# is the repo root.
#
# Self-contained: unlike the production Dockerfile (which consumes the js SDK
# and js-wasm dist built by CI), this image builds EVERYTHING from
# source, including the Rust->wasm js-wasm package — so no host
# prebuild or CI artifacts are needed. The bot is tsc-compiled to dist/ and runs
# under plain node (js-wasm ships a compiled .js via its node export).

# Stage 1: Build — Rust + Node toolchain, compile rs-core to wasm, build JS SDKs
FROM rust:1.100-slim-trixie@sha256:86993c97389ebb5487eb09e88168e2a00b0de29aa08dff9ae896049b9be96ed9 AS build
WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="/pnpm:$PATH"
# Don't let Puppeteer fetch Chromium during install (runtime image provides it).
ENV PUPPETEER_SKIP_DOWNLOAD=1
# No git in the build context; make husky's root `prepare` script a no-op.
ENV HUSKY=0

# System deps: protoc + build tooling for the Rust core, Node 26, and the
# better-sqlite3 native binding.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
     curl ca-certificates git pkg-config libssl-dev cmake g++ make python3 \
     protobuf-compiler \
  && curl -fsSL https://deb.nodesource.com/setup_26.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown
# wasm-bindgen-cli must match the `wasm-bindgen` pin in packages/rust/rs-core/Cargo.toml.
# renovate: datasource=crate depName=wasm-bindgen-cli
ARG WASM_BINDGEN_CLI_VERSION=0.2.130
RUN cargo install wasm-bindgen-cli@${WASM_BINDGEN_CLI_VERSION}

# Cargo workspace: every workspace member must be present for the workspace to
# resolve, even though only rs-core (+ rs-common) is compiled to wasm here.
COPY Cargo.toml Cargo.lock ./
COPY protos protos
COPY packages/rust/rs-common packages/rust/rs-common
COPY packages/rust/rs-core packages/rust/rs-core
COPY services services
COPY tools tools

# pnpm workspace + the JS pieces the bot needs. Frontend workspace members
# (apps/*) are intentionally NOT copied: pnpm tolerates absent members, and
# leaving them out keeps their (huge) Expo/RN deps out of node_modules.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN npm install -g "$(node -p "require('./package.json').packageManager")"
COPY patches patches
COPY packages/js/drivers/js-wasm packages/js/drivers/js-wasm
COPY packages/js/js-sdk packages/js/js-sdk
COPY packages/js/drivers/js-datastore-sqlite packages/js/drivers/js-datastore-sqlite
COPY packages/js/drivers/js-datastore-postgres packages/js/drivers/js-datastore-postgres
COPY packages/js/node-sdk packages/js/node-sdk

# allowUnusedPatches: patchedDependencies target frontend packages absent here.
RUN pnpm install --frozen-lockfile --config.allowUnusedPatches=true

# Build the Rust->wasm core (its postbuild compiles the generated bindings to
# .js so plain node can load them), then the JS SDKs, then typecheck and
# tsc-compile the bot to dist/.
RUN pnpm --filter @polycentric/js-wasm build
RUN pnpm --filter @polycentric/js-sdk \
         --filter @polycentric/js-datastore-sqlite \
         --filter @polycentric/js-datastore-postgres \
         --filter @polycentric/node-sdk build
RUN pnpm --filter @polycentric/verifier-bot exec tsc --noEmit
RUN pnpm --filter @polycentric/verifier-bot build

# Flatten the prod dependency closure into a self-contained node_modules with
# `pnpm deploy`. inject-workspace-packages enables the non-legacy deploy (a
# correct prod closure — no dev-only RN/Expo/build tooling) without changing the
# monorepo's global (symlinked) install. HUSKY=0 (set above) no-ops the root
# `prepare` so scripts can run and better-sqlite3's native binding is built.
RUN pnpm --filter @polycentric/verifier-bot --prod \
  --config.inject-workspace-packages=true --config.allowUnusedPatches=true \
  deploy /deploy

# Stage 2: Run
FROM node:26-trixie-slim@sha256:615a27817f7b9508f0de73eb1cc8fc8894ab122bee56c1a7a568b72cd1032067 AS runner
WORKDIR /app/services/verifier-bot
ENV NODE_ENV=production
# System Chromium for the Puppeteer-based verifiers (e.g. Kick).
ENV HARBOR_VERIFIER_BOT_PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
RUN apt-get update \
  && apt-get install -y --no-install-recommends chromium \
  && rm -rf /var/lib/apt/lists/*

# The self-contained deploy (node_modules + package.json) plus the bot's
# tsc-compiled dist/. js-wasm's node export resolves to compiled .js,
# so the whole chain runs under plain node.
COPY --from=build /deploy/node_modules ./node_modules
COPY --from=build /deploy/package.json ./package.json
COPY --from=build /app/services/verifier-bot/dist ./dist
RUN mkdir -p state && chown -R node:node /app/services/verifier-bot/state

USER node
EXPOSE 3002
CMD ["node", "dist/app.js"]
