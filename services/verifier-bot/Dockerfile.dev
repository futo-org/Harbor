# Local development image (referenced by the root compose.yml). Build context
# is the repo root.
#
# Self-contained: unlike the production Dockerfile (which consumes the js SDK
# and rs-core-uniffi-web dist built by CI), this image builds EVERYTHING from
# source, including the Rust->wasm rs-core-uniffi-web package — so no host
# prebuild or CI artifacts are needed. The bot is tsc-compiled to dist/ and runs
# under plain node (rs-core-uniffi-web ships a compiled .js via its node export).

# Stage 1: Build — Rust + Node toolchain, compile rs-core to wasm, build JS SDKs
FROM rust:slim-bookworm AS build
WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="/pnpm:$PATH"
# Don't let Puppeteer fetch Chromium during install (runtime image provides it).
ENV PUPPETEER_SKIP_DOWNLOAD=1
# No git in the build context; make husky's root `prepare` script a no-op.
ENV HUSKY=0

# System deps: protoc + build tooling for the Rust core, Node 24, and the
# better-sqlite3 native binding.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
     curl ca-certificates git pkg-config libssl-dev cmake g++ make python3 \
     protobuf-compiler \
  && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.19.0 --activate
RUN rustup target add wasm32-unknown-unknown

# Cargo workspace: every workspace member must be present for the workspace to
# resolve, even though only rs-core (+ rs-common) is compiled to wasm here.
COPY Cargo.toml Cargo.lock ./
COPY protos protos
COPY packages/rs-common packages/rs-common
COPY packages/rs-core packages/rs-core
COPY services services
COPY tools tools

# pnpm workspace + the JS pieces the bot needs. Frontend workspace members
# (apps/*) are intentionally NOT copied: pnpm tolerates absent members, and
# leaving them out keeps their (huge) Expo/RN deps out of node_modules.
COPY .npmrc pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY patches patches
COPY packages/rs-core-uniffi-web packages/rs-core-uniffi-web
COPY packages/js-core packages/js-core
COPY packages/js-storage-sqlite packages/js-storage-sqlite
COPY packages/js-storage-postgres packages/js-storage-postgres
COPY packages/js-node packages/js-node

# allowUnusedPatches: patchedDependencies target frontend packages absent here.
RUN pnpm install --frozen-lockfile --config.allowUnusedPatches=true

# Build the Rust->wasm core (its postbuild compiles the generated bindings to
# .js so plain node can load them), then the JS SDKs, then typecheck and
# tsc-compile the bot to dist/.
RUN pnpm --filter @polycentric/rs-core-uniffi-web build
RUN pnpm --filter @polycentric/js-core \
         --filter @polycentric/js-storage-sqlite \
         --filter @polycentric/js-storage-postgres \
         --filter @polycentric/js-node build
RUN pnpm --filter @polycentric/verifier-bot exec tsc --noEmit
RUN pnpm --filter @polycentric/verifier-bot build

# Flatten the prod dependency closure into a self-contained node_modules with
# `pnpm deploy`. inject-workspace-packages enables the non-legacy deploy (a
# correct prod closure — no dev-only RN/Expo/build tooling) without changing the
# monorepo's global (symlinked) install. HUSKY=0 (set above) no-ops the root
# `prepare` so scripts can run and better-sqlite3's native binding is built.
RUN pnpm --filter @polycentric/verifier-bot --prod \
  --config.inject-workspace-packages=true --config.allowUnusedPatches=true \
  deploy /deploy

# Stage 2: Run
FROM node:24-slim AS runner
WORKDIR /app/services/verifier-bot
ENV NODE_ENV=production
# System Chromium for the Puppeteer-based verifiers (e.g. Kick).
ENV POLYCENTRIC_VERIFIER_BOT_PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
RUN apt-get update \
  && apt-get install -y --no-install-recommends chromium \
  && rm -rf /var/lib/apt/lists/*

# The self-contained deploy (node_modules + package.json) plus the bot's
# tsc-compiled dist/. rs-core-uniffi-web's node export resolves to compiled .js,
# so the whole chain runs under plain node.
COPY --from=build /deploy/node_modules ./node_modules
COPY --from=build /deploy/package.json ./package.json
COPY --from=build /app/services/verifier-bot/dist ./dist
RUN mkdir -p state && chown -R node:node /app/services/verifier-bot/state

USER node
EXPOSE 3002
CMD ["node", "dist/app.js"]
