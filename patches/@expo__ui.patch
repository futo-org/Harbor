++ (nullable UIGestureRecognizer *)ancestorSurfaceTouchHandlerForView:(UIView *)view {
+  UIView *current = view;
+  while (current != nil) {
+    for (UIGestureRecognizer *recognizer in [current.gestureRecognizers copy]) {
+      if ([recognizer isKindOfClass:[RCTSurfaceTouchHandler class]]) {
+        return recognizer;
+      }
+    }
+    current = current.superview;
+  }
+  return nil;
+}
+
++ (void)cancelTouchHandler:(UIGestureRecognizer *)touchHandler {
+  // Only while actively tracking touches — every mounted page observes the
+  // same scroll pan, so observers after the first would pointlessly re-toggle
+  // an already-reset handler.
+  UIGestureRecognizerState state = touchHandler.state;
+  if (state != UIGestureRecognizerStateBegan && state != UIGestureRecognizerStateChanged) {
+    return;
+  }
+  // The public-API equivalent of RCTSurfaceTouchHandler's private
+  // `_cancelTouches`: disabling a recognizer mid-gesture cancels its tracked
+  // touches, which reaches JS as a touch cancel and clears active presses.
+  touchHandler.enabled = NO;
+  touchHandler.enabled = YES;
+}
