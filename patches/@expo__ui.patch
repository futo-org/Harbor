+  // ancestor's. An inline-hosted view sits under the root surface's handler;
+  // adding a second one streams every touch twice, and the duplicate start
+  // re-runs the responder negotiation, terminating the pressed child in
+  // favour of its pressable ancestor. Presented hierarchies (sheets, menus)
+  // have no ancestor handler and still get their own.
+  if ([self ancestorSurfaceTouchHandlerForView:view] != nil) {
