+// Cancels in-flight RN touches when the nearest ancestor SwiftUI scroll view
+// (e.g. the pager) begins dragging — the same behavior UIKit provides natively
+// for RN's own scroll views.
+private final class ScrollDragTouchCanceller {
+  private weak var scrollView: UIScrollView?
+  private weak var hostedView: UIView?
+
+  init?(hostedView: UIView) {
+    var current = hostedView.superview
+    while let view = current, !(view is UIScrollView) {
+      current = view.superview
+    }
+    guard let scrollView = current as? UIScrollView else {
+      return nil
+    }
+    self.hostedView = hostedView
+    self.scrollView = scrollView
+    scrollView.panGestureRecognizer.addTarget(self, action: #selector(panStateChanged(_:)))
+  }
+
+  @objc private func panStateChanged(_ recognizer: UIGestureRecognizer) {
+    guard recognizer.state == .began, let hostedView else {
+      return
+    }
+    if let handler = ExpoUITouchHandlerHelper.ancestorSurfaceTouchHandler(for: hostedView) {
+      ExpoUITouchHandlerHelper.cancelTouchHandler(handler)
+    }
+  }
+
+  deinit {
+    scrollView?.panGestureRecognizer.removeTarget(self, action: nil)
+  }
+}
