{
  "name": "@polycentric/js-core",
  "version": "0.0.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./web": {
      "types": "./dist/hosts/web.d.ts",
      "import": "./dist/web.es.js"
    },
    "./node": {
      "types": "./dist/hosts/node.d.ts",
      "import": "./dist/node.es.js",
      "require": "./dist/node.cjs.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b && webpack",
    "dev": "tsc -b && webpack --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=./junit.xml",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@polycentric/rs-core-wasm": "workspace:*"
  },
  "devDependencies": {
    "@polycentric/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "^1.52.0",
    "ts-loader": "^9.5.4",
    "typescript": "catalog:",
    "vitest": "^5.0.0",
    "webpack": "^5.100.1",
    "webpack-cli": "^7.0.0"
  }
}
