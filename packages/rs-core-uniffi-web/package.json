{
  "name": "@polycentric/rs-core-uniffi-web",
  "version": "0.0.0",
  "description": "uniffi-bindgen-react-native generated TypeScript bindings for rs-core (web/wasm target).",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.futo.org/polycentric/polycentric.git"
  },
  "type": "module",
  "main": "./dist/index.ts",
  "types": "./dist/index.ts",
  "exports": {
    ".": "./dist/index.ts",
    "./generated": "./dist/generated/polycentric_core.ts",
    "./generated/wasm-bindgen": "./dist/generated/wasm-bindgen/index.js",
    "./generated/wasm-bindgen/index_bg.wasm": "./dist/generated/wasm-bindgen/index_bg.wasm"
  },
  "files": ["dist", "ubrn.config.yaml", "ubrn-wasm-patch.toml"],
  "scripts": {
    "prebuild": "cargo install wasm-bindgen-cli --version 0.2.122 --locked",
    "build": "ubrn build web",
    "clean": "rm -rfv dist/ rust_modules/"
  },
  "dependencies": {
    "uniffi-bindgen-react-native": "0.31.0-2"
  }
}
