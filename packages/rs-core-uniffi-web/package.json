{
  "name": "@polycentric/rs-core-uniffi-web",
  "version": "0.0.0",
  "description": "uniffi-bindgen-react-native generated TypeScript bindings for rs-core (web/wasm target).",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.futo.org/polycentric/polycentric.git"
  },
  "type": "module",
  "main": "./dist/index.ts",
  "types": "./dist/index.ts",
  "exports": {
    ".": "./dist/index.ts",
    "./generated": {
      "types": "./dist/generated/polycentric_core.ts",
      "node": "./dist/generated/polycentric_core.js",
      "default": "./dist/generated/polycentric_core.ts"
    },
    "./generated/wasm-bindgen": "./dist/generated/wasm-bindgen/index.js",
    "./generated/wasm-bindgen/index_bg.wasm": "./dist/generated/wasm-bindgen/index_bg.wasm"
  },
  "files": ["dist", "ubrn.config.yaml", "ubrn-wasm-patch.toml"],
  "scripts": {
    "prebuild": "wasm-bindgen --version 2>/dev/null | grep -qF 0.2.122 || cargo install wasm-bindgen-cli --version 0.2.122 --locked --force",
    "build": "ubrn build web",
    "postbuild": "tsc -p tsconfig.node.json",
    "clean": "rm -rfv dist/ rust_modules/"
  },
  "dependencies": {
    "@ubjs/core": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "uniffi-bindgen-react-native": "catalog:"
  }
}
