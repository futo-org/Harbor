{
  "name": "@polycentric/react-native",
  "version": "0.1.0",
  "description": "Polycentric SDK for react native applications",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "browser": "./src/index.web.ts",
  "react-native": "./src/index.tsx",
  "exports": {
    ".": {
      "react-server": "./src/index.web.ts",
      "node": "./src/index.web.ts",
      "browser": "./src/index.web.ts",
      "react-native": "./src/index.tsx",
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "ubrn:ios": "ubrn build ios --and-generate",
    "ubrn:android": "ubrn build android --and-generate",
    "ubrn:clean": "rm -rfv cpp/ android/CMakeLists.txt android/src/main/java android/*.cpp ios/ src/Native* src/uniffi-init.tsx src/generated/rn",
    "dev": "bob build --watch",
    "clean": "del-cli android/build lib",
    "build": "bob build",
    "typecheck": "tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "jest"
  },
  "keywords": ["react-native", "ios", "android"],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.futo.org/polycentric/polycentric.git"
  },
  "author": "FUTO",
  "homepage": "https://polycentric.io",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.83.0",
    "@types/jest": "catalog:",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "expo-file-system": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "jest": "catalog:",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "expo-file-system": ">=18.0.0",
    "expo-sqlite": ">=14.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.83.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "{**/{__tests__,__fixtures__,__mocks__}/**,**/*.d.ts}",
    "targets": [
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "PolycentricSpec",
    "type": "modules",
    "jsSrcsDir": "src"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": ["<rootDir>/lib/"]
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@noble/curves": "catalog:",
    "@polycentric/js-browser": "workspace:*",
    "@polycentric/js-core": "workspace:*",
    "@polycentric/js-storage-sqlite": "workspace:*",
    "@polycentric/rs-core-uniffi-web": "workspace:*",
    "@ubjs/core": "catalog:",
    "drizzle-orm": "^0.45.2",
    "fast-text-encoding": "^1.0.6",
    "react-native-get-random-values": "^1.11.0",
    "uniffi-bindgen-react-native": "catalog:"
  }
}
