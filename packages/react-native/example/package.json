{
  "name": "@polycentric/react-native-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "RCT_METRO_PORT=${PORT:-9090} react-native run-android --port ${PORT:-9090}",
    "ios": "RCT_METRO_PORT=${PORT:-9090} react-native run-ios --port ${PORT:-9090}",
    "start": "RCT_METRO_PORT=${PORT:-9090} react-native start --port ${PORT:-9090}",
    "start:clean": "RCT_METRO_PORT=${PORT:-9090} react-native start --port ${PORT:-9090} --reset-cache",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --mode Debug"
  },
  "dependencies": {
    "@polycentric/react-native": "*",
    "@op-engineering/op-sqlite": "^15.2.5",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-native-svg": "^15.11.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@types/react": "^19.2.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "dotenv": "^16.4.7",
    "react-native-builder-bob": "^0.40.17",
    "react-native-monorepo-config": "^0.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
